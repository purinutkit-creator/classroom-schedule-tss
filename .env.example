# พอร์ตของเว็บ
PORT=3000
# โฟลเดอร์เก็บข้อมูล (ตารางสอน ห้อง ฟอนต์ที่อัปโหลด)
DATA_DIR=./data
# รหัสผ่านเข้าหน้าแอดมิน (เว้นว่าง = ไม่ต้องล็อกอิน)
ADMIN_PASSWORD=
# ใส่ได้ทั้งที่นี่หรือในหน้า "LINE OA" ของเว็บ (ค่าในเว็บจะถูกใช้ก่อน)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# URL สาธารณะของเว็บ (ใช้แสดง Webhook URL และลิงก์ในข้อความ)
PUBLIC_URL=
# ใช้ PostgreSQL แทนไฟล์ (จำเป็นบนโฮสต์ที่ไม่มีดิสก์ถาวร เช่น Render free)
DATABASE_URL=
# ปิดการปิงตัวเองกันหลับ (Render free)
KEEP_ALIVE=true
# v2.0: คีย์สำหรับ AI อ่านตารางจากรูป (หรือใส่ในหน้าตั้งค่า)
ANTHROPIC_API_KEY=
